# Maintainer: Emiel Kollof <emiel@kollof.nl>
pkgname=tompouce
_commit=64c7ac03b9b2f79f340887ec0c606260aa274019
_date=20261120
pkgver=0.1.0.r${_date}.${_commit:0:7}
pkgrel=3
pkgdesc='Terminal live-coding environment for music with an embedded Strudel runtime'
arch=('x86_64')
url='https://github.com/ekollof/tompouce'
license=('AGPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'notcurses>=3.0.9' 'portaudio' 'openal' 'curl'
         'cjson' 'leveldb' 'alsa-lib' 'tree-sitter>=0.25')
optdepends=('pipewire: PipeWire audio backend'
            'libpulse: PulseAudio backend'
            'libsamplerate: sample-rate conversion'
            'fluidsynth: offline GM synth fallback'
            'fluid-soundfont: GM soundfont for the FluidSynth fallback'
            'lilv: metadata-only LV2 plugin discovery')
makedepends=('cmake' 'ninja' 'pkgconf' 'xxd' 'git')
source=("git+https://github.com/ekollof/tompouce.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cmake -S "$srcdir/tompouce" -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=OFF \
    -DWITH_CCACHE=OFF \
    -DWITH_CSOUND=OFF
  cmake --build "$srcdir/build" --parallel --target tompouce
}

package() {
  # The executable resolves scripts, web assets and examples next to itself
  # through /proc/self/exe, so install it under /usr/lib and symlink /usr/bin.
  install -Dm755 "$srcdir/build/tompouce" "$pkgdir/usr/lib/tompouce/tompouce"
  install -d "$pkgdir/usr/bin"
  ln -s ../lib/tompouce/tompouce "$pkgdir/usr/bin/tompouce"

  local files=(
    README.md LICENSE NOTICE alsoft.conf
    scripts/companion.py scripts/sound_import.py scripts/query-worker.mjs
    scripts/tompoucectl.py scripts/install-daemon.py
    systemd/tompouce-daemon.service.in
    web/index.html web/companion.js web/sounds.js web/companion.css
    web/dist/editor.js web/dist/licenses.txt js/dist/licenses.txt
    thirdparty/STRUDEL-LICENSE thirdparty/quickjs/LICENSE
    thirdparty/tree-sitter-javascript/LICENSE thirdparty/strudel-csound/README.md
    thirdparty/minimp3.h thirdparty/dr_flac.h
    thirdparty/native-synth/README.md thirdparty/native-synth/LICENSE-ZzFX
    thirdparty/native-synth/LICENSE-Strudel thirdparty/native-synth/LICENSE-Kabelsalat
    thirdparty/native-synth/LICENSE-Apache-2.0 thirdparty/native-synth/LICENSE-Phaze
    thirdparty/native-synth/LICENSE-FFT thirdparty/waveforms/NOTICE
  )
  local file
  for file in "${files[@]}"; do
    install -Dm644 "$srcdir/tompouce/$file" "$pkgdir/usr/lib/tompouce/$file"
  done

  for file in arpoon.json belldub.json bassfugue.json flatrave.json \
              juxundtollerei.json strudeltutor.json; do
    install -Dm644 "$srcdir/tompouce/$file" \
      "$pkgdir/usr/lib/tompouce/examples/$file"
  done

  install -Dm644 "$srcdir/tompouce/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/tompouce/NOTICE" \
    "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
