@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tompouce: <urn:tompouce:test:state#> .

<urn:tompouce:test:midi-synth#state-quiet>
    a pset:Preset ;
    lv2:appliesTo <urn:tompouce:test:midi-synth> ;
    lv2:port [
        lv2:symbol "gain" ;
        pset:value 0.5
    ] ;
    state:state [
        tompouce:gain "0.25"^^xsd:float
    ] .
